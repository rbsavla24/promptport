{
  "manifest_version": 3,
  "name": "PromptPort 4.2",
  "version": "4.2.1",
  "description": "Export and import voice-bot prompts as markdown ZIPs (5 buckets or 2 buckets), plus Magic Port — migrate a full bot (prompt + configurations) from a 5-field dashboard to a 2-field dashboard.",
  "permissions": [
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.ringg.ai/*",
    "*://panels.gorezolv.com/*",
    "*://panels.qa.devrezolv.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptPort"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ringg.ai/*",
        "*://panels.gorezolv.com/*",
        "*://panels.qa.devrezolv.com/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.ringg.ai/*"
      ],
      "js": [
        "host.js",
        "zip.js",
        "unzip.js",
        "turndown.js",
        "turndown-plugin-gfm.js",
        "marked.min.js",
        "extract.js",
        "magicport-dom.js",
        "magicport.js",
        "magicport-import.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://panels.gorezolv.com/voicebot/*",
        "*://panels.qa.devrezolv.com/voicebot/*"
      ],
      "js": [
        "host.js",
        "zip.js",
        "unzip.js",
        "turndown.js",
        "turndown-plugin-gfm.js",
        "marked.min.js",
        "extract.js",
        "magicport-dom.js",
        "magicport.js",
        "magicport-import.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.ringg.ai/*",
        "*://panels.gorezolv.com/*",
        "*://panels.qa.devrezolv.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
