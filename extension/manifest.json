{
  "manifest_version": 3,
  "name": "PromptPort",
  "version": "3.2.4",
  "description": "Export and import voice-bot prompts as markdown ZIPs (5 buckets or 2 buckets).",
  "permissions": ["activeTab", "scripting", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["*://*.ringg.ai/*", "*://panels.gorezolv.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptPort"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ringg.ai/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.ringg.ai/*"],
      "js": ["zip.js", "unzip.js", "turndown.js", "turndown-plugin-gfm.js", "marked.min.js", "extract.js", "content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["*://panels.gorezolv.com/voicebot/*"],
      "js": ["zip.js", "unzip.js", "turndown.js", "turndown-plugin-gfm.js", "marked.min.js", "extract.js", "content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
